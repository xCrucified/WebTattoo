generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gallery {
  id        Int            @id @default(autoincrement())
  
  images    GalleryImage[]
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String

  galleryId Int
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}